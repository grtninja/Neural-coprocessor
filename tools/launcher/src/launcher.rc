            VALUE "OriginalFilename", "MGPU Bridge Launcher.exe"
            VALUE "ProductName",      "MGPU Bridge"
            VALUE "ProductVersion",   "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
